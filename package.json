{
  "name": "byazen",
  "productName": "ByAzen",
  "version": "1.0.20",
  "description": "Персональный игровой лаунчер",
  "author": "ByAzen",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/preview.cjs",
    "test": "node --test",
    "themes:art": "node scripts/theme-art.cjs",
    "build:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fs-chunk-store": "5.0.1",
    "ipaddr.js": "2.3.0",
    "webrtc-polyfill": "file:vendor/webrtc-disabled",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.byazen.launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "core/**",
      "public/**",
      "vendor/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ByAzen-${version}-win-x64-portable.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "asar": true,
    "npmRebuild": false
  },
  "overrides": {
    "webrtc-polyfill": "$webrtc-polyfill"
  }
}
